<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#FFF3E0"/>

    <!-- Rounded corners -->
    <corners android:radius="20dp"/>

    <!-- Border -->
    <stroke
        android:width="1dp"
        android:color="#FF9800"/>

    <!-- Padding inside -->
    <padding
        android:left="10dp"
        android:right="10dp"
        android:top="4dp"
        android:bottom="4dp"/>

</shape>