<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background color -->
    <solid android:color="@android:color/transparent"/>

    <!-- Corner radius -->
    <corners android:radius="12dp"/>

    <!-- Stroke border -->
    <stroke
        android:width="1.5dp"
        android:color="@color/primaryColor"/>

    <!-- Optional padding -->
    <padding
        android:left="12dp"
        android:top="8dp"
        android:right="12dp"
        android:bottom="8dp"/>

</shape>