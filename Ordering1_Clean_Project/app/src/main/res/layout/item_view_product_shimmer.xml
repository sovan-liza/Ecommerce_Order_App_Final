<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ================= PRODUCT 1 ================= -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvProduct1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="6dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E5E5E5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Image -->
                <com.denzcoskun.imageslider.ImageSlider
                    android:id="@+id/ivImageSlider1"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    app:iss_auto_cycle="false"
                    android:background="#E0E0E0"/>

                <!-- Title -->
                <TextView
                    android:id="@+id/tvProductTitle1"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="#E0E0E0"/>

                <!-- Quantity -->
                <TextView
                    android:id="@+id/tvProductQuantity1"
                    android:layout_width="70dp"
                    android:layout_height="14dp"
                    android:background="#E0E0E0"/>

                <!-- Price + Edit -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvProductPrice1"
                        android:layout_width="50dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="6dp"
                        android:background="#E0E0E0"
                        android:textSize="15sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/tvEdit1"
                        android:layout_width="90dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="8dp"
                        android:background="#E0E0E0"
                        android:layout_gravity="end"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- ================= PRODUCT 2 ================= -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvProduct2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="6dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E5E5E5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Image -->
                <com.denzcoskun.imageslider.ImageSlider
                    android:id="@+id/ivImageSlider2"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    app:iss_auto_cycle="false"
                    android:background="#E0E0E0" />

                <!-- Title -->
                <TextView
                    android:id="@+id/tvProductTitle2"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="#E0E0E0"/>

                <!-- Quantity -->
                <TextView
                    android:id="@+id/tvProductQuantity2"
                    android:layout_width="70dp"
                    android:layout_height="14dp"
                    android:background="#E0E0E0"/>

                <!-- Price + Edit -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvProductPrice2"
                        android:layout_width="50dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="6dp"
                        android:background="#E0E0E0"
                        android:textSize="15sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/tvEdit2"
                        android:layout_width="90dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="8dp"
                        android:background="#E0E0E0"
                        android:layout_gravity="end"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>