<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.ordering1.auth.SplashFragment">

        <action
            android:id="@+id/action_splashFragment_to_signInFragment"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.example.ordering1.auth.SingInFragment">

        <action
            android:id="@+id/action_signInFragment_to_OTPFragment"
            app:destination="@id/OTPFragment"/>
    </fragment>

    <fragment
        android:id="@+id/OTPFragment"
        android:name="com.example.ordering1.auth.OTPFragment" />
</navigation>